# Copy to .env and edit. NEVER commit the real .env file.
# Local-dev default matches docker-compose.yml (Postgres on localhost:5432).
DATABASE_URL=postgresql+psycopg://printstudio:printstudio@localhost:5432/printstudio
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=60
BCRYPT_ROUNDS=12
# Used only by `python -m scripts.seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
